DATABASE_URL=postgresql+psycopg://caregiver:caregiver_dev@localhost:5432/ai_caregiver
MONGO_URL=mongodb://localhost:27017
MONGO_DB=ai_caregiver

# Resolved via `ant auth login` if unset — see backend/README.md
ANTHROPIC_API_KEY=

CARE_AGENT_MODEL=claude-sonnet-5

# Auth layer (02-Software-Architecture/AUTH_LAYER.md §3, §9 step 2) — RS256
# JWT keypair. Leave all four unset for local dev: app/auth/keys.py will
# generate a keypair on first run and cache it under JWT_KEY_DIR so restarts
# don't invalidate every session — a loud warning is logged when this
# happens. That fallback is dev-only; set real key material for anything
# resembling a shared/prod environment.
#
# Option A — inline PEM (prod/CI: inject via secrets manager). Escape
# newlines as literal \n:
# JWT_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
#
# Option B — file paths (also works for local dev if you'd rather generate
# once yourself: `openssl genrsa -out .keys/jwt_private.pem 2048 && openssl
# rsa -in .keys/jwt_private.pem -pubout -out .keys/jwt_public.pem`):
# JWT_PRIVATE_KEY_PATH=.keys/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=.keys/jwt_public.pem
JWT_KEY_DIR=.keys

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
